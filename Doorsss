local function neutralize(obj)
	pcall(function() obj:Destroy() end)
	pcall(function()
		if obj.Parent then obj.Parent = nil end
		for _, c in ipairs(obj:GetDescendants()) do
			if c:IsA("BasePart") then
				c.CanCollide = false
				c.Transparency = 1
				c.Anchored = true
			end
			if c:IsA("Sound") then
				c:Stop()
				c.Volume = 0
			end
			if c:IsA("ProximityPrompt") or c:IsA("ClickDetector") then
				c.Enabled = false
			end
		end
	end)
end

local function shouldKill(name)
	if not (Toggles.AntiAll and Toggles.AntiAll.Value) then return false end
	for _, n in ipairs(KillList) do
		if name == n then return true end
	end
	for realName, toggleName in pairs(OptionalKill) do
		if name == realName and Toggles[toggleName] and Toggles[toggleName].Value then
			return true
		end
	end
	return false
end

task.spawn(function()
	while true do
		if Toggles.AntiAll and Toggles.AntiAll.Value then
			for _, obj in ipairs(workspace:GetDescendants()) do
				if shouldKill(obj.Name) then
					neutralize(obj)
				end
			end
			for _, folderName in ipairs({"Entities", "CurrentRooms", "Rooms", "GameObjects"}) do
				local folder = workspace:FindFirstChild(folderName)
				if folder then
					for _, obj in ipairs(folder:GetDescendants()) do
						if shouldKill(obj.Name) then
							neutralize(obj)
						end
					end
				end
			end
		end
		task.wait(0.11)
	end
end)

